# ==========================================
# RainSense Farmer - Production Environment Variables
# ==========================================

# Server Configuration (Render automatically injects PORT)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# CORS Configuration: Comma-separated list of allowed frontend domains
# Example: https://rainsense-farmer.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# Database (Default: local SQLite database; supports PostgreSQL)
# For Render PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./rainsense.db
DB_PATH=./rainsense.db

# Weather & Geospatial Data Providers
# Open-Meteo does not require an API key for non-commercial usage.
WEATHER_API_KEY=
RAINFALL_API_KEY=
SOIL_API_KEY=
MAP_API_KEY=

# Application Settings
CACHE_TTL_SECONDS=600
RAIN_DETECTED_THRESHOLD_MM=0.1
MAX_SAVED_LOCATIONS=5

# Frontend Deployment Configuration (Vercel)
# Set this on Vercel environment variables to point to your Render backend:
# NEXT_PUBLIC_API_URL=https://rainsense-farmer-backend.onrender.com
# VITE_API_URL=https://rainsense-farmer-backend.onrender.com
NEXT_PUBLIC_API_URL=
VITE_API_URL=
